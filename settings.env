# Strategy settings: Trend + EMA 50 Retest.
# Edit this file on GitHub (pencil icon), commit, then run the 2 install lines on the server.

# ---- which strategy the live bot runs ----
# ema   = 4H trend + 1m EMA 50 cross/retest (current)
# range = 4H + 1H trend + 5-minute high/low lines + 1m break/retest/big candle (tested: loses)
# htf   = Daily + 4H trend + 1-hour high/low lines + 15m break/retest/big candle (test paused)
# orb   = 4H + 1H trend + New York opening range lines + 1m break/retest/big candle (tested: near break-even)
# smc   = Smart Money: 4H structure, 1H liquidity sweep -> displacement -> OB/FVG retest, 15m confirmation (tested: loses)
# rsi   = RSI alert bot: information only (overbought / oversold coins, most extreme first)
STRATEGY=rsi
# range strategy: lines from the last X closed 5-minute candles
RANGE_5M_BARS=1
# range strategy: big candle volume at least X times the average
RANGE_VOL_MULT=1.5
# smc strategy: displacement candle body at least X times the normal 1H candle size (ATR)
SMC_DISP_ATR=1.5
# smc strategy: the displacement must come within X 1H candles after the sweep
SMC_DISP_BARS=3
# smc strategy: price must return to the OB/FVG within X hours, then confirm within Y hours
SMC_RETEST_HOURS=24
SMC_CONFIRM_HOURS=4
# smc strategy: minimum confluence score (3, 4 or 5)
SMC_MIN_SCORE=4
# smc strategy: targets in R (1:2 and 1:3)
SMC_TP1_R=2
SMC_TP2_R=3
# smc strategy: no new signal on the same coin for X minutes (300 = 5 hours)
SMC_COOLDOWN_MIN=300
# smc strategy: only the X most liquid coins
SMC_TOP_COINS=40
# orb strategy: New York open time (New York clock; summer/winter time handled automatically)
ORB_OPEN_HOUR=9
ORB_OPEN_MINUTE=30
# orb strategy: the lines are the high/low of the first X minutes after the open
ORB_RANGE_MIN=5
# orb strategy: signals allowed for X minutes after the range is complete
ORB_WINDOW_MIN=180
# orb strategy: at most X signals per coin per day, weekdays only
ORB_MAX_SIGNALS=1
ORB_WEEKDAYS_ONLY=true
# htf strategy: lines from the last X closed 1-hour candles
HTF_LEVEL_BARS=1
# htf strategy: break, retest and big candle must happen within X minutes
HTF_RETEST_WINDOW_MIN=180
# htf strategy: stop at least X% and at most Y% from entry
HTF_MIN_SL_PCT=0.5
HTF_MAX_SL_PCT=5
# htf strategy: pause per coin after a signal (minutes)
HTF_COOLDOWN_MIN=120

# ---- RSI alert bot (STRATEGY=rsi) ----
# overbought: 5-minute RSI above X AND 4H RSI above Y (set Y to 0 to drop the 4H condition)
RSI_OB_5M=70
RSI_OB_4H=70
# oversold (5-minute RSI) by market cap: below SMALL under MCAP_SMALL, below MID between, below LARGE above MCAP_LARGE
RSI_OS_SMALL=20
RSI_OS_MID=25
RSI_OS_LARGE=30
MCAP_SMALL=50000000
MCAP_LARGE=100000000
# a coin is announced again only after RSI moved back out of the zone by X points
RSI_RESET_GAP=5
# at most X separate messages per 5 minutes; the rest come as one list
RSI_MAX_ALERTS=15
# optional free CoinGecko demo key (higher limits); empty works too
COINGECKO_API_KEY=

# ---- coins (Binance USDT-M Futures) ----
MIN_24H_VOLUME_USDT=3000000

# ---- step 1: 4H trend ----
# 4H EMA length
TREND_EMA=50
# EMA must be higher (uptrend) / lower (downtrend) than this many 4H candles ago
TREND_SLOPE_BARS=3

# ---- step 2: 15m check ----
# true = LONG only if 15m price is above the 15m EMA, SHORT only if below
USE_15M_FILTER=true
MID_EMA=50

# ---- market structure shift filters ----
# true = no SHORT after the coin's 1H closes above its last swing high,
#        no LONG after it closes below its last swing low
USE_SHIFT_FILTER=true
# candles on each side that confirm a swing high / low (3 = standard)
SHIFT_PIVOT=3
# true = when BTC's 15m structure shifts, pause signals in the old direction on all coins
USE_BTC_FILTER=true
# how long the BTC pause lasts (minutes)
BTC_PAUSE_MIN=60

# ---- extra filters ----
# true = LONG signals only while Bitcoin's own 4H is in an uptrend
LONG_NEEDS_BTC_UP=true
# LONG signals: on | off | strong (strong = only when at least LONG_STRONG_BREADTH of all coins are in a 4H uptrend)
LONG_MODE=on
LONG_STRONG_BREADTH=0.5
# on the big candle, market buyers (LONG) / market sellers (SHORT) must be at least this share of volume
TAKER_MIN_SHARE=0.55
# true = check open interest and funding before each signal
USE_OI_FILTER=true
# open interest must not fall over this many minutes (multiples of 5)
OI_WINDOW_MIN=30
# minimum open interest change in % over that window (0 = must not fall)
OI_MIN_CHANGE_PCT=0
# skip SHORT if funding is at or below minus this %, skip LONG if at or above this % (squeeze risk)
FUNDING_EXTREME_PCT=0.05
# squeeze warning: skip when open interest is slowing AND funding is at least this strong against
# the trade AND accounts are crowded (long/short ratio at or below LS_CROWDED_SHORT for SHORT,
# at or above LS_CROWDED_LONG for LONG)
FUNDING_STRONG_PCT=0.03
LS_CROWDED_SHORT=0.8
LS_CROWDED_LONG=2.5

# ---- limit entry ----
# true = entry is a limit (Post Only) order slightly better than the candle close (0.02% fee instead of 0.05%)
USE_LIMIT_ENTRY=true
# how much better than the close (part of a normal 1m candle size)
LIMIT_OFFSET_ATR=0.1
# minutes to wait for the fill; after that the signal is cancelled
LIMIT_VALID_MIN=3

# ---- step 3: 1m entry ----
ENTRY_EMA=50
# cross, retest and big candle must all happen within this many minutes
RETEST_WINDOW_MIN=15
# extra confirmation on the big candle (test it first with backtest.py):
#   off   = not used
#   align = EMA 3 above EMA 9 above EMA 21 for LONG (below for SHORT)
#   fresh = align + EMA 3 crossed EMA 9 and EMA 21 within the last 3 candles
CONFIRM_EMA_MODE=fresh
# big candle = body at least X times the average body of the last 20 candles
BIG_CANDLE_MULT=1.5
# big candle volume at least X times the average volume
CONFIRM_VOL_MULT=1.0
# how close a wick must come to the EMA to count as a retest (part of a normal candle size)
TOUCH_TOLERANCE_ATR=0.1
# a close this far through the EMA cancels the setup (part of a normal candle size)
CLOSE_TOLERANCE_ATR=0.25

# ---- self-learning model ----
# true = the bot trains a model on its own finished signals and uses it when it helps
USE_LEARNING=true
# start learning after this many finished signals
LEARN_MIN_SIGNALS=500
# retrain every X days
LEARN_EVERY_DAYS=7
# test each new model on the last X days, which it has not seen
LEARN_TEST_DAYS=7
# at least this many signals in the test days
LEARN_MIN_TEST=100
# switch the model ON only if the signals it keeps earn at least this much more R per signal
LEARN_MIN_GAIN_R=0.1
# ... while keeping at least this share of signals (0.25 = 25%)
LEARN_MIN_KEEP=0.25

# ---- step 4: stop and targets ----
# stop never closer than this % from entry (protects against fees)
MIN_SL_PCT=0.3
# skip signals whose stop is wider than this %
MAX_SL_PCT=3
TP1_R=1.5
TP2_R=3
TP1_CLOSE_PCT=50
MOVE_SL_TO_BE_AFTER_TP1=true

# ---- other ----
# no new signal on the same coin for this many minutes after a signal
COOLDOWN_MINUTES=30
# Telegram status report every X hours (0 = off)
STATUS_HOURS=1
# shown in each signal as a suggestion
LEVERAGE=10
RISK_PCT=1
